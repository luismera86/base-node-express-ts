model user {
  id         String    @id @default(uuid())
  first_name String
  last_name  String
  email      String    @unique
  password   String
  role       String    @default("user")
  is_active              Boolean   @default(true)
  reset_token            String?
  reset_token_expires_at DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  deleted_at             DateTime?

  @@map("users")
}
