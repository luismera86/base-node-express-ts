# Entorno de los tests e2e: usa su PROPIA base de datos (nunca la de desarrollo).
# El nombre de la DB DEBE contener "test" — setup-e2e-db.ts aborta si no.
NODE_ENV=local
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/base_node_express_test
PORT=3000
API_URL=http://localhost:3000/api

JWT_ACCESS_SECRET=e2e_access_secret_min_32_chars_long_padding_
JWT_REFRESH_SECRET=e2e_refresh_secret_min_32_chars_long_padding
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

CORS_ORIGINS=*
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=fatal
