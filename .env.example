NODE_ENV=local
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mydb
PORT=3000
API_URL=http://localhost:3000/api

# Secretos JWT (mín. 32 caracteres, DEBEN ser distintos entre sí).
# Generar cada uno con: openssl rand -hex 32
JWT_ACCESS_SECRET=changeme_generate_a_strong_secret_min_32_chars_a
JWT_REFRESH_SECRET=changeme_generate_a_strong_secret_min_32_chars_b
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Flag Secure de las cookies de auth (solo HTTPS). Sin valor: true en prod, false en el resto.
# COOKIE_SECURE=true

# Orígenes permitidos por CORS, separados por comas. "*" permite todos (solo local).
CORS_ORIGINS=*

# Tamaño máximo del body JSON.
# BODY_LIMIT=100kb

# SMTP: sin MAIL_HOST los correos se loguean en vez de enviarse (útil en local).
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com

# Base del frontend para los enlaces de verificación / recuperación.
FRONTEND_URL=http://localhost:5173
# PASSWORD_RESET_TTL_MINUTES=60
# EMAIL_VERIFICATION_TTL_MINUTES=1440

# Habilita /docs. Sin valor: true salvo en prod.
# SWAGGER_ENABLED=true

# Nivel de log de pino: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info
