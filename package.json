{
    "name": "base-node-express-ts",
    "version": "1.3.3",
    "description": "Plantilla base Node.js + TypeScript + Express con Prisma, autenticación JWT y documentación OpenAPI auto-generada.",
    "main": "dist/app.js",
    "scripts": {
        "dev": "tsx watch --include 'src/**/*' src/app.ts",
        "start": "pnpm run build && if [ $? -eq 0 ]; then node dist/app.js; else echo 'Build failed'; exit 1; fi",
        "build": "tsc --incremental",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier --write .",
        "migrate": "prisma migrate dev",
        "migrate:deploy": "prisma migrate deploy",
        "seed": "prisma migrate reset --force --skip-seed && tsx ./src/seeds/seed.ts",
        "create:module": "chmod +x ./scripts/modules/create-module.sh && ./scripts/modules/create-module.sh",
        "create:use-case": "chmod +x ./scripts/modules/create-use-case.sh && ./scripts/modules/create-use-case.sh",
        "create:swagger-docs": "chmod +x ./scripts/modules/create-swagger-docs.sh && ./scripts/modules/create-swagger-docs.sh",
        "studio": "prisma studio"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@11.13.1",
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@faker-js/faker": "^10.4.0",
        "@types/argon2": "^0.14.1",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/ms": "^2.1.0",
        "@types/node": "^20.19.27",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^6.4.17",
        "@types/supertest": "^6.0.2",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/eslint-plugin": "^8.27.0",
        "@typescript-eslint/parser": "^8.27.0",
        "@vitest/coverage-v8": "^3.0.5",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-unused-imports": "^4.1.4",
        "globals": "^16.0.0",
        "prettier": "^3.5.3",
        "prisma": "^7.8.0",
        "supertest": "^6.3.4",
        "tsx": "^4.23.1",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.27.0",
        "vitest": "^3.0.5"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^8.5.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "argon2": "^0.44.0",
        "class-transformer": "^0.5.1",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.18.3",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "jose": "^6.2.2",
        "ms": "^2.1.3",
        "node-cron": "^4.0.7",
        "nodemailer": "^8.0.6",
        "pg": "^8.14.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "rotating-file-stream": "^3.2.9",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.3.6"
    }
}
