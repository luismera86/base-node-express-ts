{
  "name": "express-ts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:dev": "NODE_ENV=dev tsnd --respawn --clear src/app.ts",
    "start:local": "NODE_ENV=local tsnd --respawn --clear src/app.ts",
    "start:qa": "NODE_ENV=qa tsnd --respawn --clear src/app.ts",
    "start:prod": "NODE_ENV=prod tsnd --respawn --clear src/app.ts",
    "build": "rimraf ./dist && tsc",
    "start": "npm run build && node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "typeorm": "npx typeorm",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate -d ./src/config/datasource.config.ts ./src/migrations/$npm_config_name",
    "migration:run": "npx ts-node ./node_modules/typeorm/cli.js migration:run -d ./src/config/datasource.config.ts",
    "migration:revert": "npx ts-node ./node_modules/typeorm/cli.js migration:revert -d ./src/config/datasource.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.27",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.27.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "chalk": "4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "mysql": "^2.18.1",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.21",
    "winston": "^3.17.0",
    "zod": "^3.24.3"
  }
}
