{
    "name": "express-ts",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start:dev": "NODE_ENV=dev tsnd --respawn --clear src/app.ts",
        "start:local": "npm run build && NODE_ENV=local tsnd --respawn --clear src/app.ts",
        "start:qa": "NODE_ENV=qa tsnd --respawn --clear src/app.ts",
        "start:prod": "NODE_ENV=prod tsnd --respawn --clear src/app.ts",
        "build": "tsc --incremental",
        "start": "npm run build && if [ $? -eq 0 ]; then node dist/app.js; else echo 'Build failed'; exit 1; fi",
        "test": "jest",
        "test:watch": "npm run build && jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier --write .",
        "typeorm": "npx typeorm",
        "migration:generate": "npx typeorm-ts-node-commonjs migration:generate -d ./src/config/datasource.config.ts ./src/migrations/$npm_config_name",
        "migration:run": "npx ts-node ./node_modules/typeorm/cli.js migration:run -d ./src/config/datasource.config.ts",
        "migration:revert": "npx ts-node ./node_modules/typeorm/cli.js migration:revert -d ./src/config/datasource.config.ts",
        "seed": "npx ts-node ./src/seeds/drop-db.ts && npm run migration:run && npx ts-node ./src/seeds/seed.ts",
        "create:module": "chmod +x ./scripts/modules/create-module.sh && ./scripts/modules/create-module.sh",
        "create:use-case": "chmod +x ./scripts/modules/create-use-case.sh && ./scripts/modules/create-use-case.sh",
        "create:swagger-docs": "chmod +x ./scripts/modules/create-swagger-docs.sh && ./scripts/modules/create-swagger-docs.sh"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@types/aws-sdk": "^0.0.42",
        "@types/bcrypt": "^5.0.2",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/express-fileupload": "^1.5.1",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^20.11.27",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^6.4.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^9.0.0",
        "@typescript-eslint/eslint-plugin": "^8.27.0",
        "@typescript-eslint/parser": "^8.27.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-unused-imports": "^4.1.4",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "prettier": "^3.5.3",
        "rimraf": "^5.0.5",
        "supertest": "^6.3.4",
        "ts-jest": "^29.3.3",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.27.0"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^7.3.0",
        "@aws-sdk/lib-storage": "^3.817.0",
        "@aws-sdk/s3-request-presigner": "^3.817.0",
        "@js-temporal/polyfill": "^0.5.1",
        "@types/express-session": "^1.18.1",
        "@types/passport-google-oauth20": "^2.0.16",
        "@types/passport-microsoft": "^1.0.3",
        "aws-sdk": "^2.1692.0",
        "bcrypt": "^5.1.1",
        "chalk": "4.1.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.5",
        "express": "^4.18.3",
        "express-fileupload": "^1.5.1",
        "express-session": "^1.18.1",
        "jsonwebtoken": "^9.0.2",
        "mysql": "^2.18.1",
        "node-cron": "^4.0.7",
        "nodemailer": "^7.0.3",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "passport-microsoft": "^2.1.0",
        "pg": "^8.14.1",
        "reflect-metadata": "^0.2.2",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "^0.3.21",
        "typeorm-naming-strategies": "^4.1.0",
        "winston": "^3.17.0",
        "zod": "^3.24.3"
    }
}
